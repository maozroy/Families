# Copy to a file systemd (or your process manager) reads, and fill in.
# Nothing here has a default baked into the source: an installation's identity
# is configuration, not code.

HOST=127.0.0.1
PORT=3011

# ── identity ────────────────────────────────────────────────────────────────
# The owner account. Required — the server refuses to start without it.
FAMILY_OWNER_EMAIL=you@example.com

# Who a stuck relative is told to contact. Defaults to a generic "the site
# owner" if unset.
FAMILY_OWNER_NAME_HE=
FAMILY_OWNER_NAME_EN=

# ── auth ────────────────────────────────────────────────────────────────────
# google | cf | both. The server refuses to start half-configured.
AUTH_MODE=google
FAMILY_SESSION_KEY=            # openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public hostname, used to recognise its own origin.
FAMILY_LIVE_HOST=tree.example.org
FAMILY_STAGING_HOST=

# WhatsApp one-time codes (optional second door).
FAMILY_OTP_URL=
FAMILY_OTP_TOKEN=

# ── optional integrations ───────────────────────────────────────────────────
# A MediaWiki to hand a signed-in reader over to. Unset disables the link.
FAMILY_WIKI_ORIGIN=
FAMILY_HANDOFF_WIKI_ORIGINS=

# Directory of prebuilt DNA visualisation pages. Unset disables /dna.
FAMILY_DNA_DIR=

# A CommonJS module exporting { log, wrapHttp } for shared access logging.
FAMILY_AUDIT_MODULE=

# Where the family display names are seeded from.
FAMILY_SEED_NAMES=config/seed-names.json
